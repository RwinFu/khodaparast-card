<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#062A30"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="@string/eyebrow"
            android:textColor="#71D7C8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/heading"
            android:textColor="#F1FFFD"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/person_name"
            android:textColor="#D9F4F0"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/description"
            android:textColor="#B2D2D0"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/status_panel"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_label"
                android:textColor="#9AC8C5"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/status_ready"
                android:textColor="#71D7C8"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/detail_ready"
                android:textColor="#DBF0ED"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/toggle_nfc"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/button_primary"
            android:backgroundTint="@null"
            android:text="@string/start_nfc"
            android:textAllCaps="false"
            android:textColor="#062A30"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/nfc_settings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_secondary"
            android:backgroundTint="@null"
            android:text="@string/open_nfc_settings"
            android:textAllCaps="false"
            android:textColor="#E9FAF7"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/open_card"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_secondary"
            android:backgroundTint="@null"
            android:text="@string/open_card"
            android:textAllCaps="false"
            android:textColor="#E9FAF7"
            android:textSize="14sp" />

        <Button
            android:id="@+id/show_qr"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_secondary"
            android:backgroundTint="@null"
            android:text="@string/show_qr"
            android:textAllCaps="false"
            android:textColor="#E9FAF7"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/footer_note"
            android:textColor="#92B6B4"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
